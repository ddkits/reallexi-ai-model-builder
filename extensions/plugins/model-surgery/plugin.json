{
  "id": "model-surgery",
  "name": "Model Surgery",
  "version": "0.1.0",
  "owner": "Reallexi LLC",
  "license": "Apache-2.0",
  "copyright": "Copyright (c) 2026 Reallexi LLC. All rights reserved.",
  "description": "Community depth expansion, resource planning, and continual pre-training for Llama and Qwen2 text models.",
  "extension_points": ["ui.page", "ui.asset", "api.route", "job.lifecycle"],
  "core_safe": true,
  "enabled_by_default": true,
  "permissions": ["ui:iframe", "core-admin-bridge"],
  "pages": [{"id": "model-surgery.page", "title": "Model Surgery", "description": "Plan, expand, heal, and evaluate a larger text model.", "entry_file": "ui/index.html", "mode": "iframe", "navigation": true, "order": 15, "required_role": "admin"}],
  "ui_files": [
    {"id": "model-surgery.page", "path": "ui/index.html", "kind": "page"},
    {"id": "model-surgery.styles", "path": "ui/styles.css", "kind": "style"},
    {"id": "model-surgery.app", "path": "ui/app.js", "kind": "script"}
  ],
  "api_routes": [
    {"id": "model-surgery.catalog", "method": "GET", "path": "/extensions/runtime/model-surgery/catalog", "target": "reviewed-code", "auth": "admin-token", "handler": "model-surgery.backend:run_api_route"},
    {"id": "model-surgery.jobs-list", "method": "GET", "path": "/extensions/runtime/model-surgery/jobs", "target": "reviewed-code", "auth": "admin-token", "handler": "model-surgery.backend:run_api_route"},
    {"id": "model-surgery.preflight", "method": "POST", "path": "/extensions/runtime/model-surgery/preflight", "target": "reviewed-code", "auth": "admin-token", "handler": "model-surgery.backend:run_api_route"},
    {"id": "model-surgery.jobs-create", "method": "POST", "path": "/extensions/runtime/model-surgery/jobs", "target": "reviewed-code", "auth": "admin-token", "handler": "model-surgery.backend:run_api_route"},
    {"id": "model-surgery.dataset", "method": "POST", "path": "/extensions/runtime/model-surgery/dataset", "target": "reviewed-code", "auth": "admin-token", "handler": "model-surgery.backend:run_api_route"},
    {"id": "model-surgery.cancel", "method": "POST", "path": "/extensions/runtime/model-surgery/cancel", "target": "reviewed-code", "auth": "admin-token", "handler": "model-surgery.backend:run_api_route"}
  ],
  "code_modules": [
    {"id": "model-surgery.backend", "runtime": "backend", "mode": "reviewed-code", "path": "backend/plugin.py", "hook": "api.route.register", "handler": "run_api_route"},
    {"id": "model-surgery.engine", "runtime": "backend", "mode": "reviewed-code", "path": "backend/surgery.py", "hook": "job.lifecycle"},
    {"id": "model-surgery.healing", "runtime": "backend", "mode": "reviewed-code", "path": "backend/healing.py", "hook": "job.lifecycle"},
    {"id": "model-surgery.worker", "runtime": "backend", "mode": "reviewed-code", "path": "backend/worker.py", "hook": "job.lifecycle", "handler": "run_job", "description": "Subprocess entry point for this extension's own queue; not a core TrainingJob worker."},
    {"id": "model-surgery.frontend", "runtime": "frontend", "mode": "static-ui", "path": "ui/app.js", "hook": "app.navigation.items"}
  ]
}
